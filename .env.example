# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

GEMINI_API_KEY=

# Google Cloud project with "Maps JavaScript API" + "Places API (New)" enabled.
# The key is exposed to the browser (NEXT_PUBLIC_), so restrict it in Cloud
# Console to your site's HTTP referrers and to just those two APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
