# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

GEMINI_API_KEY=

# Google Cloud project with "Maps JavaScript API" + "Places API (New)" enabled.
# The key is exposed to the browser (NEXT_PUBLIC_), so restrict it in Cloud
# Console to your site's HTTP referrers and to just those two APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (streak reminders). Generate a pair with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@abracadish.app

# Shared secret Vercel Cron sends as a Bearer token when calling
# /api/push/send-streak-reminders. Any random string; leave unset locally
# to call the route without auth during testing.
CRON_SECRET=
